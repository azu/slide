      "link": null,
      "text": "class Cat<T> {\n  public whiskers: number;\n  public tail: T;\n\n  constructor(count: number, tail: T) {\n    this.whiskers = count;\n    this.tail = tail;\n  }\n}\n\nthrow Error();",
